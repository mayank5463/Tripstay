<!-- ================= Footer ================= -->
<!--
  Link honesty note: every link below points to a real route in this app
  (Explore, category pages, city search, Place your listing, Privacy,
  Terms). Placeholder links with href="#" (Help center, Careers, social
  icons, locale switcher, etc.) have been removed — add them back once
  those pages/features actually exist.
-->
<style>
  :root {
    --ts-primary: #0f4c3a;
    --ts-accent: #c9a227;
    --ts-footer-bg: #0b2f24;
    --ts-footer-border: rgba(255, 255, 255, 0.1);
    --ts-footer-text: #cfd8d2;
    --ts-footer-muted: #8ea295;
  }

  .ts-footer {
    background: var(--ts-footer-bg);
    color: var(--ts-footer-text);
    font-family: "Inter", sans-serif;
    margin-top: 3rem;
  }
  .ts-footer-inner { max-width: 1500px; margin: 0 auto; padding: 3rem 1.25rem 1.5rem; }

  /* ── Top area: brand block + link groups ─────────────────────────── */
  .ts-footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }
  @media (min-width: 576px) {
    .ts-footer-top { grid-template-columns: repeat(2, 1fr); gap: 0 2.5rem; }
    .ts-footer-brand { grid-column: 1 / -1; }
  }
  @media (min-width: 992px) {
    .ts-footer-top { grid-template-columns: 1.3fr repeat(3, 1fr); gap: 2.5rem; align-items: start; }
    .ts-footer-brand { grid-column: auto; }
  }

  .ts-footer-brand { padding-bottom: 1.75rem; }
  .ts-footer-brand-word {
    font-family: 'Fraunces', serif; font-weight: 700; font-size: 1.5rem; color: #fff;
    display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.85rem;
  }
  .ts-footer-brand-logo {
    width: 2.2rem; height: 2.2rem; border-radius: 50%; background: var(--ts-accent);
    color: var(--ts-primary); display: flex; align-items: center; justify-content: center; font-size: 1rem;
  }
  .ts-footer-tagline { font-size: 0.88rem; line-height: 1.55; max-width: 30ch; margin-bottom: 0; }

  /* Link groups — native <details> so they're collapsible accordions on
     mobile, forced visually "always open" on tablet/desktop. */
  .ts-footer-group { border-bottom: 1px solid var(--ts-footer-border); }
  .ts-footer-group summary {
    cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 0; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    font-size: 0.76rem; color: #fff;
  }
  .ts-footer-group summary::-webkit-details-marker { display: none; }
  .ts-footer-group summary .ts-chevron { transition: transform 0.2s ease; font-size: 0.7rem; color: var(--ts-footer-muted); }
  .ts-footer-group[open] summary .ts-chevron { transform: rotate(180deg); }
  .ts-footer-group ul { list-style: none; margin: 0; padding: 0 0 1.1rem; display: flex; flex-direction: column; gap: 0.65rem; }
  .ts-footer-group a {
    color: var(--ts-footer-text); text-decoration: none; font-size: 0.87rem;
    transition: color 0.15s ease;
  }
  .ts-footer-group a:hover { color: var(--ts-accent); }

  @media (min-width: 768px) {
    .ts-footer-group { border-bottom: none; }
    .ts-footer-group summary { pointer-events: none; padding: 0 0 1rem; }
    .ts-footer-group summary .ts-chevron { display: none; }
    .ts-footer-group ul { padding-bottom: 0; }
  }

  /* ── Bottom bar: copyright + legal links only ────────────────────── */
  .ts-footer-bottom {
    margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--ts-footer-border);
    display: flex; flex-direction: column; gap: 1rem; align-items: center; text-align: center;
    font-size: 0.82rem; color: var(--ts-footer-muted);
  }
  @media (min-width: 768px) {
    .ts-footer-bottom { flex-direction: row; justify-content: space-between; text-align: left; }
  }

  .ts-footer-legal { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; }
  .ts-footer-legal a { color: var(--ts-footer-muted); text-decoration: none; font-size: 0.82rem; transition: color 0.15s ease; }
  .ts-footer-legal a:hover { color: #fff; }
</style>

<footer class="ts-footer">
  <div class="ts-footer-inner">
    <div class="ts-footer-top">

      <!-- Brand column — always full-width on its own row, never collapsible -->
      <div class="ts-footer-brand">
        <div class="ts-footer-brand-word">
          <span class="ts-footer-brand-logo"><i class="fa-regular fa-compass"></i></span>
          TripStay
        </div>
        <p class="ts-footer-tagline">
          Find stays that feel like home — from city rooms to mountain
          hideaways, wherever the trip takes you.
        </p>
      </div>

      <!-- Real routes -->
      <details class="ts-footer-group" open>
        <summary>Explore <i class="fa-solid fa-chevron-down ts-chevron"></i></summary>
        <ul>
          <li><a href="/listings">All stays</a></li>
          <li><a href="/listings/category/Trending">Trending</a></li>
          <li><a href="/listings/category/Iconic%20Cities">Iconic cities</a></li>
          <li><a href="/listings/category/Mountains">Mountains</a></li>
          <li><a href="/listings/category/Amazing%20Pools">Amazing pools</a></li>
        </ul>
      </details>

      <!-- Popular cities — real, goes through the existing city search route -->
      <details class="ts-footer-group" open>
        <summary>Popular cities <i class="fa-solid fa-chevron-down ts-chevron"></i></summary>
        <ul>
          <li><a href="/listings/search?city=Paris">Paris</a></li>
          <li><a href="/listings/search?city=London">London</a></li>
          <li><a href="/listings/search?city=Dubai">Dubai</a></li>
          <li><a href="/listings/search?city=Bangkok">Bangkok</a></li>
          <li><a href="/listings/search?city=New%20York">New York</a></li>
          <li><a href="/listings/search?city=Bali">Bali</a></li>
        </ul>
      </details>

      <!-- Real routes only -->
      <details class="ts-footer-group" open>
        <summary>Company <i class="fa-solid fa-chevron-down ts-chevron"></i></summary>
        <ul>
          <li><a href="/listings/new">Place your listing</a></li>
        </ul>
      </details>

    </div>

    <div class="ts-footer-bottom" style="justify-content: center;">
      <div class="ts-footer-copy">
        &copy; <%= new Date().getFullYear() %> TripStay Private Limited. All rights reserved.
      </div>
    </div>
  </div>
</footer>
