<% layout("/layouts/boilerplate") -%>
<div class="row">
    <div class="col-8 offset-2">
        <br><br>
 <h1>Create a New Listing</h1>      
    <form method="POST" action="/listings" novalidate class="needs-validation">
      <div class="mb-3">
         <lable for = "title" class="form-label">Title</lable>
         <input name="listing[title]" placeholder="Enter Title" type="text" class="form-control" required >
         <div class="invalid-feedback">Enter the Appropriate Title!</div>
         <div class="valid-feedback">Title Looks Awesome!</div>
      </div>
     <div class="mb-3">
        <lable for = "description" class="form-label">Description</lable>
        <textarea name="listing[description]"  class="form-control" required > Enter the Description</textarea>
        <div class="invalid-feedback">Please Enter the Appropriote Decription</div>
      </div>

     <div class="mb-3">
        <lable for = "image" class="form-label">Image Link</lable>
       <input name="listing[image]" placeholder="Enter image URL/LINK" type="text" class="form-control" >
       <div class="valid-feedback">Image looks Great!</div>
      </div>
    <div class="row">
     <div class="mb-3 col-md-4">
        <lable for = "price" class="form-label">Price</lable>
       <input name="listing[price]" placeholder="Enter Price" type="number" class="form-control" required >
       <div class="invalid-feedback">Enter Correct  Price</div>
      </div>
     
      <div class="mb-3 col-md-8">
        <lable for = "country" class="form-label">Country</lable>
       <input name="listing[country]" placeholder="Enter Country" type="text" class="form-control" required>
       <div class="invalid-feedback">Enter Correct Country!</div>
      </div>
      </div>
      
      <div class="mb-3">
        <lable for = "location" class="form-label">Location</lable>
        <input name="listing[location]" placeholder="Enter Location" type="text" class="form-control" required >
        <div class="invalid-feedback">Enter the Correct Location</div>
      </div>
       <br>
      <button class="btn btn-dark add-btn">Add</button>
      <br><br>
    </form>
 </div>
</div>

